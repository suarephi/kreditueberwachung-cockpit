# Copy to .streamlit/secrets.toml locally (gitignored), or paste into
# Streamlit Cloud's "Secrets" panel for the deployed app.

[database]
# Supabase pooler URI — Settings → Database → Connection string → URI
# Use the *Session* pooler (port 5432) or *Transaction* pooler (port 6543).
# Streamlit Cloud should use the Transaction pooler for short-lived connections.
url = "postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
